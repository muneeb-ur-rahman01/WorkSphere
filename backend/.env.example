PORT=5000
NODE_ENV=development

CLIENT_URL=http://localhost:5173

# ============================================================
# Secure API Gateway
# ============================================================
# Comma-separated list of allowed browser origins in production, e.g.:
#   CORS_ORIGINS=https://app.worksphere.com,https://admin.worksphere.com
# Falls back to CLIENT_URL above if unset. In production, leaving both
# unset means NO cross-origin browser requests are allowed (fail closed).
CORS_ORIGINS=

# Max time (ms) a single request may take before the gateway responds
# with a 503 rather than letting it hang indefinitely.
REQUEST_TIMEOUT_MS=30000

# Max JSON / urlencoded request body size accepted before the gateway
# rejects the request with 413.
JSON_BODY_LIMIT=2mb
URLENCODED_BODY_LIMIT=2mb

# ============================================================
# Redis (rate limiting, login lockouts, cooldowns, short-lived caching)
# ============================================================
# Required for the security features below to be enforced across
# multiple instances. If unset, the app still runs, but those
# protections fail open (see config/redis.js) — do not run production
# without this set.
REDIS_URL=redis://localhost:6379

# ============================================================
# Rate limiting thresholds (all optional — sane defaults are built in)
# ============================================================
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=20
# PUBLIC_RATE_LIMIT_WINDOW_MS=900000
# PUBLIC_RATE_LIMIT_MAX=100
# API_RATE_LIMIT_WINDOW_MS=60000
# API_RATE_LIMIT_MAX=300
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MS=900000
# FORGOT_PASSWORD_COOLDOWN_MS=60000
# PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
# PASSWORD_RESET_RATE_LIMIT_MAX=10
# REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000
# REGISTRATION_RATE_LIMIT_MAX=10
# TWO_FACTOR_RATE_LIMIT_WINDOW_MS=900000
# TWO_FACTOR_RATE_LIMIT_MAX=10
# OTP_RATE_LIMIT_WINDOW_MS=900000
# OTP_RATE_LIMIT_MAX=10
# FILE_UPLOAD_RATE_LIMIT_WINDOW_MS=900000
# FILE_UPLOAD_RATE_LIMIT_MAX=30
# EXPENSIVE_RATE_LIMIT_WINDOW_MS=900000
# EXPENSIVE_RATE_LIMIT_MAX=20
SUPABASE_URL=https://taqsfjzjuipyycopwgxn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRhcXNmanpqdWlweXljb3B3Z3huIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NTgzMDE5NSwiZXhwIjoyMTAxNDA2MTk1fQ.Rg3qAAoMfgNAG96r8121zBZsRfrPzjqr1HxTMI4zIi4
JWT_SECRET=Your_Secret
JWT_EXPIRES_IN=7d

# SMTP (Forgot Password emails)
# Any standard SMTP provider works (Gmail App Password, SendGrid, Mailgun,
# Postmark, AWS SES, etc). If left blank, reset links are printed to the
# backend console instead of emailed, so the flow still works in local dev.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=worksphere.thf@gmail.com
# SMTP_PASS=qukc uuzl bflf wbaw
# SMTP_FROM=WorkSphere <worksphere.thf@gmail.com>

BREVO_API_KEY=your_key
BREVO_FROM_EMAIL=worksphere.thf@gmail.com
BREVO_FROM_NAME=WorkSphere


# Gemini API (AI Prescription Voice-to-Text)
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6KYknwtMX5aMruqkcYGbiPlm_vZQc8_IB0UZKj6C99azQ
GEMINI_MODEL=gemini-2.0-flash

# ============================================================
# Payment Gateway (pluggable — see backend/utils/paymentGateways/)
# ============================================================
# Which adapter is active. Switching this is the ONLY change needed to
# move providers — no controller/route/billing code needs to change.
PAYMENT_GATEWAY=payfast
# Public base URL this backend is reachable at, used to build the gateway
# callback URL (falls back to PAYMENT_RETURN_URL below if set explicitly).
API_URL=http://localhost:5000
# Optional override for the full callback URL if you don't want it derived
# from API_URL (e.g. behind a reverse proxy with a different public path).
PAYMENT_RETURN_URL=

# --- PayFast (Pakistan) — default gateway, SBP-licensed ---
# Get these from your PayFast merchant portal: https://gopayfast.com
PAYFAST_ENV=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
PAYFAST_STORE_ID=
# Only set these if your PayFast integration guide gives you different
# sandbox/production endpoints than the defaults in payfast.js.
PAYFAST_TOKEN_URL=
PAYFAST_CHECKOUT_URL=

# --- JazzCash (Hosted Checkout / Page Post) — alternate gateway ---
# Get these from your JazzCash merchant portal: https://developer.jazzcash.com.pk/
JAZZCASH_ENV=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

